# Copie para .env e ajuste. Valores abaixo são só de desenvolvimento.
DATABASE_URL=postgres://agendaflui:agendaflui@localhost:54329/agendaflui
# EXEMPLO: troque por um valor aleatório com 32+ caracteres (ex.: openssl rand -hex 32)
APP_SECRET=EXEMPLO-troque-este-valor-por-um-segredo-aleatorio-de-32-ou-mais
DEV_HOST=dev.localhost:3000
PAINEL_HOST=painel.localhost:3000
API_HOST=api.localhost:3000
# Origens do app web que podem chamar a API pelo navegador (CORS e retorno do pagamento), separadas por vírgula.
# Fora de produção localhost já é liberado; os apps iOS e Android não precisam disto.
APP_WEB_ORIGINS=https://app.agendaflui.com.br
STORAGE_DIR=.local/storage
# Servidor de e-mail em produção (smtp://usuario:senha@smtp.exemplo.com:587); em desenvolvimento os e-mails vão para .local/mail.
# SMTP_URL=
# Ou o Resend (substitui o SMTP quando as duas existem); o domínio de MAIL_FROM precisa estar verificado no Resend.
# RESEND_API_KEY=
# Remetente dos e-mails; obrigatório em produção quando SMTP_URL ou RESEND_API_KEY está definida.
MAIL_FROM=AgendaFlui <nao-responda@agendaflui.localhost>
# Token do Expo para o push, só se a sua conta Expo exigir; em desenvolvimento o push vai para .local/push.
# EXPO_ACCESS_TOKEN=
# Envio de avisos e limpezas periódicas dentro do servidor (padrão true); false desliga só isso nesta instância.
# O envio das métricas de uso da API roda sempre, independente desta variável.
WORKER_ENABLED=true
# Proxies confiáveis na frente do app (0 a 5); com 0 o IP do cliente não é conhecido e o limite por IP não vale.
TRUSTED_PROXY_HOPS=0
NODE_ENV=development
# Conta de administrador de demonstração (usada pelo seed)
SEED_ADMIN_EMAIL=admin@agendaflui.localhost
SEED_ADMIN_PASSWORD=EXEMPLO-troque-esta-senha
# Usuários de demonstração: todos usam esta senha. Dono, gerente e profissional de cada conta
# entram com dono.patas@, gerente.patas@, profissional.patas@ (e .navalha@) em agendaflui.localhost.
SEED_USER_PASSWORD=EXEMPLO-troque-esta-senha-tambem

# ---- Produção (variáveis do contêiner; nunca coloque valores reais neste arquivo) ----
# NODE_ENV=production                                  # a imagem Docker já define
# DATABASE_URL=                                        # URL do Postgres 17+ (com sslmode, como a plataforma fornece); o banco precisa da extensão btree_gist
# DIRECT_URL=                                          # opcional: conexão direta, sem pooler; as migrações usam esta quando existe
# DATABASE_USE_DIRECT_URL=false                        # true: o servidor também usa DIRECT_URL (se o pooler não mantiver o fuso UTC)
# APP_SECRET=                                          # segredo aleatório de 32+ caracteres (openssl rand -hex 32)
# DEV_HOST=dev.seudominio.com                          # host do painel dev, sem https:// (obrigatório, distinto, não local)
# PAINEL_HOST=painel.seudominio.com                    # host do painel do negócio
# API_HOST=api.seudominio.com                          # host da API do aplicativo
# APP_WEB_ORIGINS=https://app.agendaflui.com.br        # origens do app web (https, separadas por vírgula); vazio = app web sem acesso à API
# APP_WEB_URL=https://app.agendaflui.com.br           # endereço do app web (só esquema e host; https em produção): base do link para clientes de cada loja
# TRUSTED_PROXY_HOPS=1                                 # proxies confiáveis na frente (1 atrás do Coolify); 0 desliga limites por IP
# STORAGE_DIR=/data/storage                            # pasta das imagens enviadas; precisa existir e ser gravável (volume persistente)
# SMTP_URL=                                            # envio de e-mail; sem ela e sem RESEND_API_KEY convites e cadastro pelo app não chegam
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=                  # base64 de 32 bytes; obrigatória com várias instâncias (a mesma em todas)
# RESEND_API_KEY=                                      # alternativa ao SMTP (vale o Resend se as duas existem); o domínio de MAIL_FROM precisa estar verificado no Resend
# MAIL_FROM=                                           # remetente dos e-mails; obrigatório com SMTP_URL ou RESEND_API_KEY
# EXPO_ACCESS_TOKEN=                                   # opcional: token do Expo para push
# WORKER_ENABLED=true                                  # false desliga o envio de avisos e as limpezas nesta instância
# INTEGRATIONS_MODE=real                               # Mercado Pago, Frenet e ViaCEP: real (padrão em produção) ou fake (só desenvolvimento e teste)
# MIGRATE_ON_START=true                                # false não aplica as migrações na partida

