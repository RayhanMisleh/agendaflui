model Notification {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId    String              @map("business_id") @db.Uuid
  kind          NotificationKind
  channel       NotificationChannel
  customerId    String?             @map("customer_id") @db.Uuid
  membershipId  String?             @map("membership_id") @db.Uuid
  appointmentId String?             @map("appointment_id") @db.Uuid
  scheduledFor  DateTime            @map("scheduled_for") @db.Timestamptz(3)
  status        NotificationStatus  @default(PENDING)
  attempts      Int                 @default(0)
  lastError     String?             @map("last_error")
  sentAt        DateTime?           @map("sent_at") @db.Timestamptz(3)
  lockedUntil   DateTime?           @map("locked_until") @db.Timestamptz(3)
  // Identificador da rodada de envio que reservou a linha; a atualização final confere que ainda é esta.
  lockedBy      String?             @map("locked_by")
  // Quando a próxima tentativa pode sair depois de uma falha. `scheduledFor` é o horário previsto e nunca muda.
  nextAttemptAt DateTime?           @map("next_attempt_at") @db.Timestamptz(3)
  skipReason    String?             @map("skip_reason")
  payload       Json                @default("{}")
  dedupeKey     String              @map("dedupe_key")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  membership  Membership?  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([businessId, id])
  @@unique([businessId, dedupeKey])
  @@index([status, scheduledFor, lockedUntil])
  @@index([status, updatedAt])
  @@index([customerId])
  @@index([membershipId])
  @@index([appointmentId])
  @@map("notifications")
}

/// Código de 6 dígitos enviado por e-mail (plataforma): SIGNUP (subject = id da loja) e EMAIL_CHANGE (subject = id da pessoa).
/// Índice parcial `email_codes_live_key` (um código vivo por propósito, assunto e e-mail) e CHECKs: só no SQL.
model EmailCode {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purpose    EmailCodePurpose
  subject    String
  email      String
  codeHash   String           @map("code_hash")
