generator client {
  provider = "prisma-client"
  output   = "../src/server/db/generated"
}

datasource db {
  provider = "postgresql"
}

enum Niche {
  PET

  @@map("niche")
}

enum PetSpecies {
  DOG
  CAT

  @@map("pet_species")
}

enum PetSize {
  SMALL
  MEDIUM
  LARGE
  GIANT

  @@map("pet_size")
}

enum PetCoat {
  SHORT
  MEDIUM
  LONG

  @@map("pet_coat")
}

enum PriceVariant {
  DOG_SMALL
  DOG_MEDIUM
  DOG_LARGE
  DOG_GIANT
  CAT

  @@map("price_variant")
}

enum PricingMode {
  SINGLE
  BY_VARIANT

  @@map("pricing_mode")
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("business_status")
}

enum MembershipRole {
  OWNER
  MANAGER
  PROFESSIONAL

  @@map("membership_role")
}

enum CoverMaterial {
  LEATHER
  LINEN
  WOOD
  ENAMEL

  @@map("cover_material")
}

enum AuditActorType {
  PLATFORM_ADMIN
  USER
  SYSTEM

  @@map("audit_actor_type")
}

enum UserTokenPurpose {
  INVITE
  PASSWORD_RESET

  @@map("user_token_purpose")
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY

  @@map("weekday")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW

  @@map("appointment_status")
}

enum AppointmentSource {
  APP
  PANEL

  @@map("appointment_source")
}

enum PartyType {
  CUSTOMER
  MEMBER
  PLATFORM_ADMIN
  SYSTEM

  @@map("party_type")
}

enum LoyaltyEntryKind {
  EARN
  EARN_REVERSAL
  REDEEM
  REDEEM_REVERSAL
  ADJUST

  @@map("loyalty_entry_kind")
}

enum RedemptionStatus {
  PENDING
  DELIVERED
  CANCELED

  @@map("redemption_status")
}

enum PaymentProvider {
  MERCADO_PAGO

  @@map("payment_provider")
}

enum PaymentStatus {
  PENDING
  IN_PROCESS
  APPROVED
  REJECTED
  CANCELED
  REFUNDED
  CHARGED_BACK

  @@map("payment_status")
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  CANCELED
  EXPIRED

  @@map("order_status")
}

enum FulfillmentStatus {
  PENDING
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED

  @@map("fulfillment_status")
}

enum DeliveryMethod {
  PICKUP
  SHIPPING

  @@map("delivery_method")
}

enum NotificationKind {
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_REMINDER_24H
  APPOINTMENT_REMINDER_1H
  APPOINTMENT_COMPLETED
  PROFESSIONAL_FREE_EARLY
  STAFF_NEW_APPOINTMENT
  STAFF_APPOINTMENT_CANCELED
  STAFF_APPOINTMENT_RESCHEDULED
  APPOINTMENT_REQUESTED

  @@map("notification_kind")
}

enum NotificationChannel {
  EMAIL

  @@map("notification_channel")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELED
  SKIPPED

  @@map("notification_status")
}

enum CustomerOrigin {
  APP
  PANEL

  @@map("customer_origin")
}

enum EmailCodePurpose {
  SIGNUP
  EMAIL_CHANGE

  @@map("email_code_purpose")
}

model PlatformAdmin {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  platformSessions PlatformSession[]
  impersonations   Session[]
  supportHandoffs  SupportHandoff[]

  @@map("platform_admins")
}

model PlatformSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId   String    @map("admin_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  ip        String?
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("platform_sessions")
}

/// Token de passagem do "entrar como": o cookie do painel dev não vale no host do painel, então o admin leva este token
/// (só o hash fica aqui; 60 s; uso único) e a rota do painel o troca por uma sessão de suporte.
model SupportHandoff {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId    String    @map("admin_id") @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  admin    PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([businessId])
  @@map("support_handoffs")
}

/// Uma execução do agendador (avisos, limpeza, loja, retenção). Tabela da plataforma: sem dado de conta nem pessoal no resumo.
model SchedulerRun {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// `notifications`, `cleanup`, `store` ou `retention` (lista fechada por CHECK no banco).
  kind       String
  startedAt  DateTime  @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  ok         Boolean
  /// Contagens curtas ou o nome do erro; nunca dado pessoal.
  summary    String    @default("")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([kind, startedAt])
  @@index([startedAt])
  @@map("scheduler_runs")
}

model Business {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// O CHECK `businesses_slug_not_reserved` (só no SQL) recusa os nomes de `RESERVED_SLUGS` (rotas do sistema).
  slug          String         @unique
  name          String
  document      String?
  email         String?
  phone         String?
  addressLine   String?        @map("address_line")
  city          String?
  state         String?
  postalCode    String?        @map("postal_code")
  timezone      String         @default("America/Sao_Paulo")
  status        BusinessStatus @default(ACTIVE)
  /// Nicho da conta; nulo = conta sem nicho (agenda genérica, sem pets).
  niche         Niche?
  /// Controle de edição: cada gravação pelo painel dev exige a versão lida e a incrementa.
  version       Int            @default(1)
  /// Nome sem acentos e em minúsculas, para a busca da lista de contas.
  searchName    String         @default("") @map("search_name")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  branding    BusinessBranding?
  modules     BusinessModules?
  settings    BusinessSettings?
  integrations BusinessIntegration?
  memberships Membership[]
  sessions    Session[] @relation("SessionActiveBusiness")
  customerSessions Session[] @relation("SessionCustomerBusiness")
  uploads     Upload[]
  auditLogs   AuditLog[]

  customers            Customer[]
  pets                 Pet[]
  professionals        Professional[]
  services             Service[]
  servicePrices        ServicePrice[]
  professionalServices ProfessionalService[]
  workingHours         WorkingHours[]
  timeBlocks           TimeBlock[]
  closures             BusinessClosure[]
  appointments         Appointment[]
  appointmentItems     AppointmentItem[]
  loyaltyTransactions  LoyaltyTransaction[]
  prizes               Prize[]
  banners              Banner[]
  prizeRedemptions     PrizeRedemption[]
  storeSettings        StoreSettings?
  productCategories    ProductCategory[]
  products             Product[]
  productImages        ProductImage[]
  addresses            Address[]
  orders               Order[]
  payments             Payment[]
  orderItems           OrderItem[]
  notifications        Notification[]
  supportHandoffs      SupportHandoff[]

  @@map("businesses")
}

model BusinessBranding {
  businessId         String        @id @map("business_id") @db.Uuid
  displayName        String        @map("display_name")
  logoUploadId       String?       @map("logo_upload_id") @db.Uuid
  symbolUploadId     String?       @map("symbol_upload_id") @db.Uuid
  faviconUploadId    String?       @map("favicon_upload_id") @db.Uuid
  loginImageUploadId String?       @map("login_image_upload_id") @db.Uuid
  primaryColor       String        @default("#0B6E66") @map("primary_color")
  accentColor        String        @default("#F2A93B") @map("accent_color")
  coverMaterial      CoverMaterial @default(LEATHER) @map("cover_material")
  /// Controle de edição da marca pelo painel dev: cada gravação exige a versão lida e a incrementa.
  version            Int           @default(1)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  logo       Upload?  @relation("BrandingLogo", fields: [logoUploadId], references: [id], onDelete: SetNull)
  symbol     Upload?  @relation("BrandingSymbol", fields: [symbolUploadId], references: [id], onDelete: SetNull)
  favicon    Upload?  @relation("BrandingFavicon", fields: [faviconUploadId], references: [id], onDelete: SetNull)
  loginImage Upload?  @relation("BrandingLoginImage", fields: [loginImageUploadId], references: [id], onDelete: SetNull)

  @@map("business_branding")
}

model BusinessModules {
  businessId String   @id @map("business_id") @db.Uuid
  loyalty    Boolean  @default(false)
  banners    Boolean  @default(false)
  store      Boolean  @default(false)
  /// Controle de edição dos módulos: sobe a cada mudança.
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_modules")
}

/// Credenciais de integração da conta (Mercado Pago e Frenet), cifradas em repouso. Modelo de PLATAFORMA: `tenantDb` o recusa;
/// só o painel dev grava e só o domínio da loja lê (`integration-secrets.ts`). O texto puro nunca vai ao banco.
model BusinessIntegration {
  businessId             String    @id @map("business_id") @db.Uuid
  mpAccessTokenEnc       String?   @map("mp_access_token_enc")
  mpAccessTokenLast4     String?   @map("mp_access_token_last4") @db.VarChar(4)
  mpWebhookSecretEnc     String?   @map("mp_webhook_secret_enc")
  mpWebhookSecretLast4   String?   @map("mp_webhook_secret_last4") @db.VarChar(4)
  mpWebhookKey           String?   @unique @map("mp_webhook_key")
  mpUpdatedAt            DateTime? @map("mp_updated_at") @db.Timestamptz(3)
  frenetTokenEnc         String?   @map("frenet_token_enc")
  frenetTokenLast4       String?   @map("frenet_token_last4") @db.VarChar(4)
  frenetUpdatedAt        DateTime? @map("frenet_updated_at") @db.Timestamptz(3)
  /// Controle de edição: cada gravação pelo painel dev exige a versão lida e a incrementa.
  version                Int       @default(1)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_integrations")
}

/// Configurações da plataforma, uma linha só (CHECK `platform_settings_single_row` e `platform_settings_google_together`, só no SQL).
/// Hoje guarda as chaves do "Entrar com Google": o segredo selado (secret-box, AAD `platform:google:client_secret`) e os 4 últimos.
/// Modelo de PLATAFORMA: `tenantDb` o recusa; só o painel dev grava e só `auth/google` lê (`google-secrets.ts`).
model PlatformSetting {
  id                      Int       @id @default(1)
  googleClientId          String?   @map("google_client_id")
  googleClientSecretEnc   String?   @map("google_client_secret_enc")
  googleClientSecretLast4 String?   @map("google_client_secret_last4") @db.VarChar(4)
  googleUpdatedAt         DateTime? @map("google_updated_at") @db.Timestamptz(3)
  /// Controle de edição: cada gravação pelo painel dev exige a versão lida e a incrementa.
  version                 Int       @default(1)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_settings")
}

model BusinessSettings {
  businessId               String   @id @map("business_id") @db.Uuid
  slotStepMin              Int      @default(15) @map("slot_step_min")
  minLeadMin               Int      @default(60) @map("min_lead_min")
  maxAdvanceDays           Int      @default(60) @map("max_advance_days")
  customerChangeWindowMin  Int      @default(120) @map("customer_change_window_min")
  bufferMin                Int      @default(0) @map("buffer_min")
  autoConfirm              Boolean  @default(true) @map("auto_confirm")
  loyaltyRankingEnabled    Boolean  @default(false) @map("loyalty_ranking_enabled")
  notifications            Json     @default("{}")
  /// Opções do nicho (esquema no registro `src/server/niches`). CHECK `business_settings_niche_options_check` (objeto): só no SQL.
  nicheOptions             Json     @default("{}") @map("niche_options")
  /// Controle de edição de regras de agenda e avisos (uma versão só para o conjunto): cada gravação que muda algo a incrementa.
  version                  Int      @default(1)
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_settings")
}

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  email          String    @unique
  passwordHash   String?   @map("password_hash")
  phone          String?
  /// Quando o e-mail foi provado (convite, código, link de senha ou Google). Toda conta ativa tem.
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  /// Identidade fixa da conta Google (`sub`); único. Os três campos do Google vêm juntos (CHECK `users_google_together`, só no SQL).
  googleSub      String?   @unique @map("google_sub")
  googleEmail    String?   @map("google_email")
  googleLinkedAt DateTime? @map("google_linked_at") @db.Timestamptz(3)
  /// Nome sem acentos e em minúsculas, para a busca de donos na lista de contas.
  searchName     String    @default("") @map("search_name")
  avatarUploadId String?   @map("avatar_upload_id") @db.Uuid
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  // CHECK `users_active_verified` (senha ou Google exige e-mail verificado): só no SQL.
  avatar      Upload?      @relation("UserAvatar", fields: [avatarUploadId], references: [id], onDelete: SetNull)
  memberships Membership[]
  sessions    Session[]
  tokens      UserToken[]
  customers   Customer[]

  @@map("users")
}

model Membership {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String         @map("business_id") @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  role       MembershipRole
  active     Boolean        @default(true)
  // Instante em que o e-mail de convite não foi aceito pelo canal; NULL quando saiu (ou ainda não houve envio).
  inviteMailFailedAt DateTime? @map("invite_mail_failed_at") @db.Timestamptz(3)
  // Dono ou gerente que quer receber por push os avisos de todos os agendamentos da loja, não só dos próprios.
  notifyAllAppointments Boolean @default(false) @map("notify_all_appointments")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  professionals Professional[]
  notifications Notification[]

  @@unique([businessId, id])
  @@unique([businessId, userId])
  @@index([userId])
  // O índice único parcial (user_id) WHERE active vive só na migração: um login da equipe tem no máximo um vínculo ativo.
  @@map("memberships")
}

model Session {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String?   @map("user_id") @db.Uuid
  impersonatorAdminId String?   @map("impersonator_admin_id") @db.Uuid
  activeBusinessId    String?   @map("active_business_id") @db.Uuid
  /// Última loja usada pelo cliente (só orienta o destino; nada confia nela sozinha).
  customerBusinessId  String?   @map("customer_business_id") @db.Uuid
  tokenHash           String    @unique @map("token_hash")
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)
  ip                  String?
  userAgent           String?   @map("user_agent")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonator   PlatformAdmin? @relation(fields: [impersonatorAdminId], references: [id], onDelete: Cascade)
  activeBusiness Business?      @relation("SessionActiveBusiness", fields: [activeBusinessId], references: [id], onDelete: SetNull)
  customerBusiness Business?    @relation("SessionCustomerBusiness", fields: [customerBusinessId], references: [id], onDelete: SetNull)

  @@index([customerBusinessId])
  @@index([userId])
  @@index([impersonatorAdminId])
  @@index([activeBusinessId])
  @@map("sessions")
}

model UserToken {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   UserTokenPurpose
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_tokens")
}

model Upload {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId    String?        @map("business_id") @db.Uuid
  path          String         @unique
  mimeType      String         @map("mime_type")
  sizeBytes     Int            @map("size_bytes")
  width         Int
  height        Int
  createdByType AuditActorType @map("created_by_type")
  createdById   String?        @map("created_by_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  brandingLogos       BusinessBranding[] @relation("BrandingLogo")
  brandingSymbols     BusinessBranding[] @relation("BrandingSymbol")
  brandingFavicons    BusinessBranding[] @relation("BrandingFavicon")
  brandingLoginImages BusinessBranding[] @relation("BrandingLoginImage")
  userAvatars         User[]             @relation("UserAvatar")
  customerAvatars     Customer[]         @relation("CustomerAvatar")
  professionalAvatars Professional[]     @relation("ProfessionalAvatar")
  prizeImages         Prize[]            @relation("PrizeImage")
  bannerImages        Banner[]           @relation("BannerImage")
  productImages       ProductImage[]
  petPhotos           Pet[]              @relation("PetPhoto")

  @@unique([businessId, id])
  @@index([businessId])
  @@map("uploads")
}

model AuditLog {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String?        @map("business_id") @db.Uuid
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id") @db.Uuid
  actorName  String         @map("actor_name")
  onBehalf   Boolean        @default(false) @map("on_behalf")
  action     String
  targetType String?        @map("target_type")
  targetId   String?        @map("target_id")
  metadata   Json           @default("{}")
  ip         String?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("audit_logs")
}

model Customer {
  id                      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId              String         @map("business_id") @db.Uuid
  name                    String
  searchName              String         @default("") @map("search_name")
  email                   String?
  phone                   String?
  /// A pessoa dona da conta do cliente; nulo = cliente de balcão. O e-mail da cópia segue o da pessoa (CHECKs `customers_account_has_email` e `customers_linked_together`: só no SQL).
  userId                  String?        @map("user_id") @db.Uuid
  /// Quando a pessoa foi ligada a este cliente (criação ou adoção).
  linkedAt                DateTime?      @map("linked_at") @db.Timestamptz(3)
  avatarUploadId          String?        @map("avatar_upload_id") @db.Uuid
  birthDate               DateTime?      @map("birth_date") @db.Date
  notes                   String?
  isClubMember            Boolean        @default(false) @map("is_club_member")
  notifyEmailAppointments Boolean        @default(true) @map("notify_email_appointments")
  notifyEmailMarketing    Boolean        @default(false) @map("notify_email_marketing")
  origin                  CustomerOrigin
  archivedAt              DateTime?      @map("archived_at") @db.Timestamptz(3)
  anonymizedAt            DateTime?      @map("anonymized_at") @db.Timestamptz(3)
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  avatar   Upload?  @relation("CustomerAvatar", fields: [avatarUploadId], references: [id], onDelete: SetNull)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  appointments  Appointment[]
  notifications Notification[]
  pets          Pet[]

  loyaltyTransactions LoyaltyTransaction[]
  prizeRedemptions    PrizeRedemption[]
  addresses           Address[]
  orders              Order[]

  @@unique([businessId, id])
