generator client {
  provider = "prisma-client"
  output   = "../src/server/db/generated"
}

datasource db {
  provider = "postgresql"
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("business_status")
}

enum MembershipRole {
  OWNER
  MANAGER
  PROFESSIONAL

  @@map("membership_role")
}

enum CoverMaterial {
  LEATHER
  LINEN
  WOOD
  ENAMEL

  @@map("cover_material")
}

enum PaperTone {
  WHITE
  CREAM
  GRAY

  @@map("paper_tone")
}

enum FontPair {
  CLASSIC
  MODERN
  FRIENDLY

  @@map("font_pair")
}

enum AuditActorType {
  PLATFORM_ADMIN
  USER
  SYSTEM

  @@map("audit_actor_type")
}

enum UserTokenPurpose {
  INVITE
  PASSWORD_RESET

  @@map("user_token_purpose")
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY

  @@map("weekday")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW

  @@map("appointment_status")
}

enum AppointmentSource {
  APP
  PANEL

  @@map("appointment_source")
}

enum PartyType {
  CUSTOMER
  MEMBER
  PLATFORM_ADMIN
  SYSTEM

  @@map("party_type")
}

enum NotificationKind {
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_REMINDER_24H
  APPOINTMENT_REMINDER_1H
  APPOINTMENT_COMPLETED
  PROFESSIONAL_FREE_EARLY
  STAFF_NEW_APPOINTMENT
  STAFF_APPOINTMENT_CANCELED
  STAFF_APPOINTMENT_RESCHEDULED

  @@map("notification_kind")
}

enum NotificationChannel {
  EMAIL
  PUSH

  @@map("notification_channel")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELED
  SKIPPED

  @@map("notification_status")
}

enum CustomerOrigin {
  APP
  PANEL

  @@map("customer_origin")
}

model PlatformAdmin {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  platformSessions PlatformSession[]
  impersonations   Session[]

  @@map("platform_admins")
}

model PlatformSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId   String    @map("admin_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  ip        String?
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("platform_sessions")
}

model Business {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String         @unique
  name          String
  segment       String?
  document      String?
  email         String?
  phone         String?
  addressLine   String?        @map("address_line")
  city          String?
  state         String?
  postalCode    String?        @map("postal_code")
  timezone      String         @default("America/Sao_Paulo")
  status        BusinessStatus @default(ACTIVE)
  internalNotes String?        @map("internal_notes")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  branding    BusinessBranding?
  modules     BusinessModules?
  settings    BusinessSettings?
  memberships Membership[]
  sessions    Session[]
  uploads     Upload[]
  auditLogs   AuditLog[]

  customers            Customer[]
  professionals        Professional[]
  services             Service[]
  professionalServices ProfessionalService[]
  workingHours         WorkingHours[]
  timeBlocks           TimeBlock[]
  closures             BusinessClosure[]
  appointments         Appointment[]
  appointmentItems     AppointmentItem[]
  notifications        Notification[]

  @@map("businesses")
}

model BusinessBranding {
  businessId         String        @id @map("business_id") @db.Uuid
  displayName        String        @map("display_name")
  logoUploadId       String?       @map("logo_upload_id") @db.Uuid
  symbolUploadId     String?       @map("symbol_upload_id") @db.Uuid
  faviconUploadId    String?       @map("favicon_upload_id") @db.Uuid
  loginImageUploadId String?       @map("login_image_upload_id") @db.Uuid
  loginMessage       String?       @map("login_message")
  primaryColor       String        @default("#0E4F5C") @map("primary_color")
  accentColor        String        @default("#E0A030") @map("accent_color")
  coverMaterial      CoverMaterial @default(ENAMEL) @map("cover_material")
  paperTone          PaperTone     @default(WHITE) @map("paper_tone")
  fontPair           FontPair      @default(CLASSIC) @map("font_pair")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  logo       Upload?  @relation("BrandingLogo", fields: [logoUploadId], references: [id], onDelete: SetNull)
  symbol     Upload?  @relation("BrandingSymbol", fields: [symbolUploadId], references: [id], onDelete: SetNull)
  favicon    Upload?  @relation("BrandingFavicon", fields: [faviconUploadId], references: [id], onDelete: SetNull)
  loginImage Upload?  @relation("BrandingLoginImage", fields: [loginImageUploadId], references: [id], onDelete: SetNull)

  @@map("business_branding")
}

model BusinessModules {
  businessId String   @id @map("business_id") @db.Uuid
  loyalty    Boolean  @default(false)
  banners    Boolean  @default(false)
  store      Boolean  @default(false)
  vouchers   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_modules")
}

model BusinessSettings {
  businessId               String   @id @map("business_id") @db.Uuid
  slotStepMin              Int      @default(15) @map("slot_step_min")
  minLeadMin               Int      @default(60) @map("min_lead_min")
  maxAdvanceDays           Int      @default(60) @map("max_advance_days")
  customerChangeWindowMin  Int      @default(120) @map("customer_change_window_min")
  bufferMin                Int      @default(0) @map("buffer_min")
  autoConfirm              Boolean  @default(true) @map("auto_confirm")
  termProfessionalSingular String   @default("Profissional") @map("term_professional_singular")
  termProfessionalPlural   String   @default("Profissionais") @map("term_professional_plural")
  termCustomerSingular     String   @default("Cliente") @map("term_customer_singular")
  termCustomerPlural       String   @default("Clientes") @map("term_customer_plural")
  termPointsSingular       String   @default("Ponto") @map("term_points_singular")
  termPointsPlural         String   @default("Pontos") @map("term_points_plural")
  termClub                 String   @default("Clube") @map("term_club")
  loyaltyRankingEnabled    Boolean  @default(false) @map("loyalty_ranking_enabled")
  notifications            Json     @default("{}")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_settings")
}

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  email          String    @unique
  passwordHash   String?   @map("password_hash")
  avatarUploadId String?   @map("avatar_upload_id") @db.Uuid
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  avatar      Upload?      @relation("UserAvatar", fields: [avatarUploadId], references: [id], onDelete: SetNull)
  memberships Membership[]
  sessions    Session[]
  tokens      UserToken[]

  @@map("users")
}

model Membership {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String         @map("business_id") @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  role       MembershipRole
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  professionals Professional[]
  notifications Notification[]

  @@unique([businessId, id])
  @@unique([businessId, userId])
  @@index([userId])
  @@map("memberships")
}

model Session {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String?   @map("user_id") @db.Uuid
  impersonatorAdminId String?   @map("impersonator_admin_id") @db.Uuid
  activeBusinessId    String?   @map("active_business_id") @db.Uuid
  tokenHash           String    @unique @map("token_hash")
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)
  ip                  String?
  userAgent           String?   @map("user_agent")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonator   PlatformAdmin? @relation(fields: [impersonatorAdminId], references: [id], onDelete: Cascade)
  activeBusiness Business?      @relation(fields: [activeBusinessId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([impersonatorAdminId])
  @@index([activeBusinessId])
  @@map("sessions")
}

model UserToken {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   UserTokenPurpose
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_tokens")
}

model Upload {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId    String?        @map("business_id") @db.Uuid
  path          String         @unique
  mimeType      String         @map("mime_type")
  sizeBytes     Int            @map("size_bytes")
  width         Int
  height        Int
  createdByType AuditActorType @map("created_by_type")
  createdById   String?        @map("created_by_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  brandingLogos       BusinessBranding[] @relation("BrandingLogo")
  brandingSymbols     BusinessBranding[] @relation("BrandingSymbol")
  brandingFavicons    BusinessBranding[] @relation("BrandingFavicon")
  brandingLoginImages BusinessBranding[] @relation("BrandingLoginImage")
  userAvatars         User[]             @relation("UserAvatar")
  customerAvatars     Customer[]         @relation("CustomerAvatar")
  professionalAvatars Professional[]     @relation("ProfessionalAvatar")

  @@unique([businessId, id])
  @@index([businessId])
  @@map("uploads")
}

model AuditLog {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String?        @map("business_id") @db.Uuid
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id") @db.Uuid
  actorName  String         @map("actor_name")
  onBehalf   Boolean        @default(false) @map("on_behalf")
  action     String
  targetType String?        @map("target_type")
  targetId   String?        @map("target_id")
  metadata   Json           @default("{}")
  ip         String?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@map("audit_logs")
}

model Customer {
  id                      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId              String         @map("business_id") @db.Uuid
  name                    String
  email                   String?
  phone                   String?
  passwordHash            String?        @map("password_hash")
  emailVerifiedAt         DateTime?      @map("email_verified_at") @db.Timestamptz(3)
  avatarUploadId          String?        @map("avatar_upload_id") @db.Uuid
  birthDate               DateTime?      @map("birth_date") @db.Date
  notes                   String?
  isClubMember            Boolean        @default(false) @map("is_club_member")
  notifyPushAppointments  Boolean        @default(true) @map("notify_push_appointments")
  notifyEmailAppointments Boolean        @default(true) @map("notify_email_appointments")
  notifyPushMarketing     Boolean        @default(true) @map("notify_push_marketing")
  notifyEmailMarketing    Boolean        @default(false) @map("notify_email_marketing")
  origin                  CustomerOrigin
  archivedAt              DateTime?      @map("archived_at") @db.Timestamptz(3)
  anonymizedAt            DateTime?      @map("anonymized_at") @db.Timestamptz(3)
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  avatar   Upload?  @relation("CustomerAvatar", fields: [avatarUploadId], references: [id], onDelete: SetNull)

  appointments  Appointment[]
  notifications Notification[]

  @@unique([businessId, id])
  @@index([businessId, phone])
  @@index([businessId, name])
  @@map("customers")
}

model Professional {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId     String    @map("business_id") @db.Uuid
  membershipId   String?   @map("membership_id") @db.Uuid
  name           String
  avatarUploadId String?   @map("avatar_upload_id") @db.Uuid
  bio            String?
  commissionBps  Int       @default(0) @map("commission_bps")
  active         Boolean   @default(true)
  displayOrder   Int       @default(0) @map("display_order")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  avatar     Upload?     @relation("ProfessionalAvatar", fields: [avatarUploadId], references: [id], onDelete: SetNull)

  services     ProfessionalService[]
  workingHours WorkingHours[]
  timeBlocks   TimeBlock[]
  appointments Appointment[]

  @@unique([businessId, id])
  @@map("professionals")
}

model Service {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String    @map("business_id") @db.Uuid
  name         String
  description  String?
  icon         String    @default("sparkles")
  priceCents   Int       @map("price_cents")
  durationMin  Int       @map("duration_min")
  rewardPoints Int       @default(0) @map("reward_points")
  clubOnly     Boolean   @default(false) @map("club_only")
  active       Boolean   @default(true)
  displayOrder Int       @default(0) @map("display_order")
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  professionals ProfessionalService[]
  items         AppointmentItem[]

  @@unique([businessId, id])
  @@map("services")
}

model ProfessionalService {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  professionalId String   @map("professional_id") @db.Uuid
  serviceId      String   @map("service_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([businessId, id])
  @@unique([professionalId, serviceId])
  @@index([serviceId])
  @@map("professional_services")
}

model WorkingHours {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  professionalId String   @map("professional_id") @db.Uuid
  weekday        Weekday
  startMin       Int      @map("start_min")
  endMin         Int      @map("end_min")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([businessId, id])
  @@index([businessId, professionalId, weekday])
  @@map("working_hours")
}

model TimeBlock {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId     String    @map("business_id") @db.Uuid
  professionalId String    @map("professional_id") @db.Uuid
  startsAt       DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime  @map("ends_at") @db.Timestamptz(3)
  reason         String?
  createdByType  PartyType @map("created_by_type")
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([businessId, id])
  @@index([businessId, professionalId, startsAt])
  @@map("time_blocks")
}

model BusinessClosure {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  startDate  DateTime @map("start_date") @db.Date
  endDate    DateTime @map("end_date") @db.Date
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, id])
  @@index([businessId, startDate])
  @@map("business_closures")
}

model Appointment {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId       String            @map("business_id") @db.Uuid
  customerId       String            @map("customer_id") @db.Uuid
  professionalId   String            @map("professional_id") @db.Uuid
  startsAt         DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime          @map("ends_at") @db.Timestamptz(3)
  status           AppointmentStatus
  source           AppointmentSource
  totalCents       Int               @map("total_cents")
  totalDurationMin Int               @map("total_duration_min")
  commissionCents  Int?              @map("commission_cents")
  notes            String?
  createdByType    PartyType         @map("created_by_type")
  createdById      String?           @map("created_by_id") @db.Uuid
  canceledAt       DateTime?         @map("canceled_at") @db.Timestamptz(3)
  canceledByType   PartyType?        @map("canceled_by_type")
  canceledById     String?           @map("canceled_by_id") @db.Uuid
  cancelReason     String?           @map("cancel_reason")
  completedAt      DateTime?         @map("completed_at") @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)

  items         AppointmentItem[]
  notifications Notification[]

  @@unique([businessId, id])
  @@index([businessId, startsAt])
  @@index([businessId, professionalId, startsAt])
  @@index([businessId, customerId, startsAt])
  @@map("appointments")
}

model AppointmentItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  appointmentId String   @map("appointment_id") @db.Uuid
  serviceId     String   @map("service_id") @db.Uuid
  name          String
  priceCents    Int      @map("price_cents")
  durationMin   Int      @map("duration_min")
  rewardPoints  Int      @map("reward_points")
  position      Int
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([businessId, id])
  @@unique([appointmentId, position])
  @@index([serviceId])
  @@map("appointment_items")
}

model Notification {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId    String              @map("business_id") @db.Uuid
  kind          NotificationKind
  channel       NotificationChannel
  customerId    String?             @map("customer_id") @db.Uuid
  membershipId  String?             @map("membership_id") @db.Uuid
  appointmentId String?             @map("appointment_id") @db.Uuid
  scheduledFor  DateTime            @map("scheduled_for") @db.Timestamptz(3)
  status        NotificationStatus  @default(PENDING)
  attempts      Int                 @default(0)
  lastError     String?             @map("last_error")
  sentAt        DateTime?           @map("sent_at") @db.Timestamptz(3)
  payload       Json                @default("{}")
  dedupeKey     String              @map("dedupe_key")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  membership  Membership?  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([businessId, id])
  @@unique([businessId, dedupeKey])
  @@index([status, scheduledFor])
  @@index([customerId])
  @@index([membershipId])
  @@index([appointmentId])
  @@map("notifications")
}
