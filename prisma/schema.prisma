model Appointment {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId       String            @map("business_id") @db.Uuid
  customerId       String            @map("customer_id") @db.Uuid
  professionalId   String            @map("professional_id") @db.Uuid
  startsAt         DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime          @map("ends_at") @db.Timestamptz(3)
  status           AppointmentStatus
  source           AppointmentSource
  totalCents       Int               @map("total_cents")
  totalDurationMin Int               @map("total_duration_min")
  commissionCents  Int?              @map("commission_cents")
  notes            String?
  customerNote     String?           @map("customer_note")
  // Chave de idempotência do pedido do app (cabeçalho Idempotency-Key). O índice único parcial
  // (business_id, customer_id, idempotency_key) WHERE idempotency_key IS NOT NULL vive só na migração.
  idempotencyKey   String?           @map("idempotency_key")
  idempotencyKeyAt DateTime?         @map("idempotency_key_at") @db.Timestamptz(3)
  // SHA-256 do pedido original que usou a chave: a repetição compara só isto, não o estado atual do agendamento.
  idempotencyRequestHash String?     @map("idempotency_request_hash")
  createdByType    PartyType         @map("created_by_type")
  createdById      String?           @map("created_by_id") @db.Uuid
  canceledAt       DateTime?         @map("canceled_at") @db.Timestamptz(3)
  canceledByType   PartyType?        @map("canceled_by_type")
  canceledById     String?           @map("canceled_by_id") @db.Uuid
  cancelReason     String?           @map("cancel_reason")
  completedAt      DateTime?         @map("completed_at") @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)

  items         AppointmentItem[]
  notifications Notification[]

  loyaltyTransactions LoyaltyTransaction[]

  @@unique([businessId, id])
  @@index([businessId, startsAt])
  @@index([businessId, professionalId, startsAt])
  @@index([businessId, endsAt])
  @@index([businessId, customerId, startsAt])
  @@index([startsAt])
  @@index([businessId, createdAt])
  @@map("appointments")
}

