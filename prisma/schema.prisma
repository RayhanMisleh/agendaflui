  /// Minutos que o cliente tem para pagar antes de o pedido vencer e o estoque voltar.
  paymentWindowMin   Int      @default(60) @map("payment_window_min")
  /// Controle de edição: a gravação exige a versão lida.
  version            Int      @default(1)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

