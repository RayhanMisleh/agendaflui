/// Pedido da loja. Guarda nome e preço de cada item, a cópia do endereço e o serviço de frete do momento da compra. O estoque é
/// reservado ao criar e devolvido uma vez só (`stock_released_at`) ao cancelar ou vencer.
model Order {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId             String            @map("business_id") @db.Uuid
  /// Sequencial por conta, a partir de 1001.
  number                 Int
  customerId             String            @map("customer_id") @db.Uuid
  status                 OrderStatus       @default(AWAITING_PAYMENT)
  fulfillmentStatus      FulfillmentStatus @default(PENDING) @map("fulfillment_status")
  deliveryMethod         DeliveryMethod    @map("delivery_method")
  itemsCents             Int               @map("items_cents")
  shippingCents          Int               @default(0) @map("shipping_cents")
  totalCents             Int               @map("total_cents")
  shippingServiceCode    String?           @map("shipping_service_code")
  shippingServiceName    String?           @map("shipping_service_name")
  shippingDays           Int?              @map("shipping_days")
  trackingCode           String?           @map("tracking_code")
  shipRecipient          String?           @map("ship_recipient")
  shipPostalCode         String?           @map("ship_postal_code")
  shipStreet             String?           @map("ship_street")
  shipNumber             String?           @map("ship_number")
  shipComplement         String?           @map("ship_complement")
  shipDistrict           String?           @map("ship_district")
  shipCity               String?           @map("ship_city")
  shipState              String?           @map("ship_state")
  customerNote           String?           @map("customer_note")
  expiresAt              DateTime          @map("expires_at") @db.Timestamptz(3)
  paidAt                 DateTime?         @map("paid_at") @db.Timestamptz(3)
  canceledAt             DateTime?         @map("canceled_at") @db.Timestamptz(3)
  canceledByType         PartyType?        @map("canceled_by_type")
  canceledById           String?           @map("canceled_by_id") @db.Uuid
  cancelReason           String?           @map("cancel_reason")
  stockReleasedAt        DateTime?         @map("stock_released_at") @db.Timestamptz(3)
  /// `amount_mismatch`, `stock_shortfall`, `payment_reversed` ou `double_payment`: o que o dono precisa resolver (CHECK na migração).
  attention              String?
  mpPreferenceId         String?           @map("mp_preference_id")
  checkoutUrl            String?           @map("checkout_url")
  // O índice único parcial (business_id, customer_id, idempotency_key) WHERE idempotency_key IS NOT NULL vive só na migração.
  idempotencyKey         String?           @map("idempotency_key")
  idempotencyRequestHash String?           @map("idempotency_request_hash")
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: NoAction)

  items    OrderItem[]
  payments Payment[]

  @@unique([businessId, id])
  @@unique([businessId, number])
  @@index([businessId, status, expiresAt])
  @@index([businessId, customerId, createdAt])
  @@map("orders")
}

/// Pagamento do Mercado Pago de um pedido. A situação vem SEMPRE da consulta à API do Mercado Pago, nunca do corpo do aviso.
model Payment {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId        String          @map("business_id") @db.Uuid
  orderId           String          @map("order_id") @db.Uuid
  provider          PaymentProvider @default(MERCADO_PAGO)
  providerPaymentId String          @map("provider_payment_id")
  status            PaymentStatus
  statusDetail      String?         @map("status_detail")
  amountCents       Int             @map("amount_cents")
  currency          String
  approvedAt        DateTime?       @map("approved_at") @db.Timestamptz(3)
  lastSyncedAt      DateTime        @map("last_synced_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([businessId, id])
  @@unique([businessId, provider, providerPaymentId])
  @@index([orderId])
  @@map("payments")
}

model OrderItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  productId      String?  @map("product_id") @db.Uuid
  /// Cópias do momento da compra.
  name           String
  unitPriceCents Int      @map("unit_price_cents")
  quantity       Int
  totalCents     Int      @map("total_cents")
  position       Int
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: NoAction)

  @@unique([businessId, id])
  @@unique([orderId, position])
  @@index([productId])
  @@map("order_items")
}

/// Pet do cliente. Só no SQL: FKs compostas `pets_customer_id_same_business_fkey` e `pets_photo_upload_id_same_business_fkey`;
/// CHECKs `pets_size_by_species_check` (cão tem porte, gato não), `pets_name_check`, `pets_breed_check`, `pets_care_notes_check`
/// e `pets_birth_month_check` (sempre o dia 1).
model Pet {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId    String     @map("business_id") @db.Uuid
  customerId    String     @map("customer_id") @db.Uuid
  name          String
  searchName    String     @default("") @map("search_name")
  species       PetSpecies
  size          PetSize?
  breed         String?
  birthMonth    DateTime?  @map("birth_month") @db.Date
  coat          PetCoat?
  careNotes     String?    @map("care_notes")
  photoUploadId String?    @map("photo_upload_id") @db.Uuid
  archivedAt    DateTime?  @map("archived_at") @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  photo    Upload?  @relation("PetPhoto", fields: [photoUploadId], references: [id], onDelete: SetNull)

  @@unique([businessId, id])
  @@unique([businessId, customerId, id])
  @@index([businessId, customerId])
  @@index([businessId, searchName])
  @@map("pets")
}

/// Preço e tempo de um serviço por variante (animal e porte). Só no SQL: FK composta
/// `service_prices_service_id_same_business_fkey` e CHECKs `service_prices_price_cents_check` (0 a 10.000.000)
/// e `service_prices_duration_min_check` (5 a 600, múltiplo de 5).
model ServicePrice {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String       @map("business_id") @db.Uuid
  serviceId   String       @map("service_id") @db.Uuid
  variant     PriceVariant
  priceCents  Int          @map("price_cents")
  durationMin Int          @map("duration_min")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([businessId, id])
  @@unique([serviceId, variant])
  @@map("service_prices")
}
