{
  "name": "agendaflui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "tsx --conditions=react-server scripts/dev.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:tz": "TZ=UTC vitest run tests/unit/time.test.ts tests/unit/time-extra.test.ts tests/unit/time-periods.test.ts tests/unit/slots.test.ts && TZ=Asia/Tokyo vitest run tests/unit/time.test.ts tests/unit/time-extra.test.ts tests/unit/time-periods.test.ts tests/unit/slots.test.ts && TZ=America/Sao_Paulo vitest run tests/unit/time.test.ts tests/unit/time-extra.test.ts tests/unit/time-periods.test.ts tests/unit/slots.test.ts",
    "test:e2e": "playwright test",
    "db:start": "tsx scripts/db.ts start",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "tsx scripts/db.ts reset",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "smoke": "tsx --conditions=react-server scripts/smoke-pages.ts",
    "worker:once": "tsx --conditions=react-server scripts/worker-once.ts",
    "admin:create": "tsx scripts/admin-create.ts",
    "demo:create": "tsx --conditions=react-server scripts/demo-create.ts",
    "postinstall": "prisma generate",
    "start:prod": "node --import tsx scripts/start-production.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "jose": "^6.2.17",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "temporal-polyfill": "^1.0.8",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
